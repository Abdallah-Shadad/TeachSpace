@model TeachSpace.View_Models.CourseRegistrationVM

@{
    ViewData["Title"] = "Register Trainee";
    Layout = "_AdvancedLayout";
}

<div class="row">
    <div class="col-md-6 offset-md-3">
        <div class="card shadow">
            <div class="card-header bg-success text-white">
                <h4 class="mb-0">Add Trainee to Course</h4>
            </div>

            <div class="card-body">
                <h5 class="text-center mb-4">@Model.CourseName</h5>

                <form asp-action="Add" method="post">
                    <input type="hidden" asp-for="CourseId" />
                    <input type="hidden" asp-for="MaxDegree" />

                    <!-- Email -->
                    <div class="mb-3">
                        <label asp-for="TraineeEmail" class="form-label fw-bold">
                            Trainee Email
                        </label>
                        <input asp-for="TraineeEmail"
                               type="email"
                               class="form-control"
                               placeholder="example@teachspace.com" />
                        <span asp-validation-for="TraineeEmail" class="text-danger"></span>
                    </div>

                    <!-- Degree -->
                    <div class="mb-3">
                        <label asp-for="Degree" class="form-label fw-bold">
                            Initial Grade (Max: @Model.MaxDegree)
                        </label>
                        <input asp-for="Degree"
                               type="number"
                               class="form-control"
                               min="0"
                               max="@Model.MaxDegree" />
                        <span asp-validation-for="Degree" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index"
                           asp-route-id="@Model.CourseId"
                           class="btn btn-secondary">
                            Cancel
                        </a>
                        <button type="submit" class="btn btn-success">
                            Register
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
