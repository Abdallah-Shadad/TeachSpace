@model IEnumerable<TeachSpace.View_Models.NewTraineeVM>

@{
    ViewData["Title"] = "Trainees";
}

<h1>Trainees</h1>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Image</th>
            <th>Name</th>
            <th>Department</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var trainee in Model)
        {
            <tr>
                <td>
                    <img src="~/Images/@trainee.Image" alt="Image" width="80" height="80"
                         style="object-fit:cover; border-radius:8px;" />
                </td>

                <td>@trainee.Name</td>
                <td>@trainee.DepartmentName</td>
            </tr>
        }
    </tbody>
</table>
